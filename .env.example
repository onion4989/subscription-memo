# SEO — block search engine indexing while the site is in development (set to false or remove when launching)
BLOCK_SEARCH_INDEXING=true

# Database
# Local dev (docker compose): postgresql://postgres:postgres@localhost:5432/subscription_memo_dev
# Production (Dokploy Postgres): set in Dokploy environment variables only
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Local LAN device testing example: http://192.168.10.2:3000 (also enables dev origin allowlist)
AUTH_URL=

# OAuth - Google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OAuth - GitHub
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email - Xserver SMTP (same pattern as portfolio)
SMTP_HOST=
SMTP_PORT=465
MY_EMAIL=
MY_PASSWORD=

# Cron / Renewal notification job
RENEWAL_JOB_SECRET=

# Cron / Demo account daily reset (Bearer token for POST /api/cron/demo-reset)
DEMO_RESET_JOB_SECRET=

# Playwright E2E (local only — set in .env.local, never commit real values)
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
# E2E_MFA_USER_EMAIL=
# E2E_MFA_USER_PASSWORD=
# E2E_SIGNUP_EMAIL=
# E2E_SIGNUP_PASSWORD=
# E2E_IMAP_HOST=
# E2E_IMAP_PORT=993
# E2E_IMAP_USER=
# E2E_IMAP_PASSWORD=
