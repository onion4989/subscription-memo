{
  "name": "subscription-memo",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run e2e:reset-subs && LD_LIBRARY_PATH=\"${PWD}/.playwright-sysroot/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}\" playwright test",
    "test:e2e:ui": "LD_LIBRARY_PATH=\"${PWD}/.playwright-sysroot/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}\" playwright test --ui",
    "test:e2e:install-libs": "bash scripts/playwright-sysroot-libs.sh",
    "e2e:create-mfa-user": "tsx scripts/create-e2e-mfa-user.ts",
    "e2e:reset-mfa": "tsx scripts/reset-e2e-mfa.ts",
    "e2e:reset-subs": "tsx scripts/reset-e2e-subscriptions.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "backup:major": "bash scripts/backup-major.sh"
  },
  "private": true,
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "otpauth": "^9.5.1",
    "pg": "^8.20.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.5",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "imapflow": "^1.4.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
