generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  /// 表示名（ニックネーム）。新規登録では未設定。ログイン後のプロフィールで設定する想定。
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]

  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  backupCodes     BackupCode[]
  passwordResets  PasswordResetToken[]
  loginAttempts   LoginAttempt[]
  subscriptions   Subscription[]

  /// 国内携帯番号（例: 09011112222）。SMS 通知用。アカウント画面で登録。
  phoneNumber            String?
  /// 固定アバター ID（1〜9）。`public/assets/common/img_c_avatar_01.jpg` 〜 `09.jpg`
  avatarId               Int?
  notifyLeadDays         NotifyLeadDays   @default(FIVE_DAYS)
  notifyChannel          NotifyChannel    @default(EMAIL)
  /// true のときお知らせを全停止（サブスク単位の notifyEnabled は維持）
  notifyDeliveryPaused   Boolean          @default(false)
  /// ログイン後アプリのカラーテーマ ID（`src/lib/theme/themes.ts` のキー）
  themeId                String           @default("default")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  /// SHA-256 hex of the raw URL token (not bcrypt). Used for findUnique lookup.
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BackupCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 hex of the raw URL token (not bcrypt). Used for findUnique lookup.
  tokenHash String   @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum PaymentPlan {
  MONTHLY
  YEARLY
}

enum NotifyLeadDays {
  THREE_DAYS
  FIVE_DAYS
  SEVEN_DAYS
}

enum NotifyChannel {
  EMAIL
  SMS
}

model Subscription {
  id              String      @id @default(cuid())
  userId          String
  name            String
  planName        String
  paymentPlan     PaymentPlan
  monthlyAmount   Int?
  annualAmount    Int?
  contractDate    DateTime    @db.Date
  nextRenewalDate DateTime    @db.Date
  notifyEnabled   Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  renewalNotificationLogs   RenewalNotificationLog[]

  @@unique([userId, name, planName])
  @@index([userId])
}

model RenewalNotificationLog {
  id             String   @id @default(cuid())
  subscriptionId String
  renewalDate    DateTime @db.Date
  sentAt         DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, renewalDate])
  @@index([subscriptionId])
}
